SPRING_PROFILES_ACTIVE=dev

SERVER_PORT=8080

FRONTEND_PORT=4200

FRONTEND_BUILD_CONFIGURATION=production

HERE_API_KEY=
AUTH_AVAILABILITY_POLL_INTERVAL_SECONDS=10
COUNTRY_BREAKDOWN_PROVIDER=here



# Vertex AI Gemini (розрахунок фрахту, лише backend) — див. docs/vertex-ai-setup.md

VERTEX_AI_PROJECT_ID=

VERTEX_AI_LOCATION=europe-west1

VERTEX_AI_MODEL=gemini-2.5-flash

VERTEX_AI_TIMEOUT_MILLIS=60000

VERTEX_AI_MAX_OUTPUT_TOKENS=8192

VERTEX_AI_RATE_LIMIT_PER_HOUR=10

# Учётные данные GCP (не комітити): JSON SA или ADC — docs/vertex-ai-setup.md §2.1

GCP_CREDENTIALS_FILE=./secrets/gcp-sa.json



NGROK_AUTHTOKEN=

NGROK_DOMAIN=

NGROK_INSPECT_PORT=4040

GATEWAY_PORT=8081

NGROK_DEV_INSPECT_PORT=4041

GATEWAY_DEV_PORT=8082



MYSQL_DATABASE=tms_auth

MYSQL_USER=tms_user

MYSQL_PASSWORD=tms_password

MYSQL_ROOT_PASSWORD=root

MYSQL_HOST_PORT=3307



JWT_SECRET=replace-me-with-strong-secret-of-at-least-32-characters

JWT_ISSUER=

JWT_AUDIENCE=

JWT_EXPIRES_SECONDS=900

JWT_REFRESH_EXPIRES_SECONDS=604800



EMAIL_VERIFICATION_EXPIRES_SECONDS=86400

# Fallback без ngrok. Якщо NGROK_DOMAIN заданий — посилання верифікації береться з нього автоматично.
EMAIL_VERIFICATION_LINK_BASE=http://localhost:4200/verify-email

SMTP_HOST=mailhog

SMTP_PORT=1025

SMTP_USER=

SMTP_PASSWORD=

MAIL_FROM=no-reply@example.com



RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5

RATE_LIMIT_LOGIN_WINDOW_SECONDS=900

RATE_LIMIT_RESEND_VERIFICATION_SECONDS=60

RATE_LIMIT_REFRESH_MAX_REQUESTS=30

RATE_LIMIT_REFRESH_WINDOW_SECONDS=60



TOKEN_CLEANUP_RETENTION_DAYS=30

