# Залежності та збірка (Angular після ініціалізації)
node_modules/
dist/
.angular/
.env
backend/.env
frontend/.env
frontend/src/assets/app-config.local.js

# Локальна конфігурація clasp (скопіюйте з .clasp.json.example і додайте scriptId)
